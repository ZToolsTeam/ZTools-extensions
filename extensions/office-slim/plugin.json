{
  "id": "office-slim",
  "name": "办公文档瘦身",
  "version": "1.0.5",
  "description": "本地重新压缩 Word、PPT、Excel 文档，保留图片原字节，可移除作者属性与批注、导出原图 ZIP；只另存新副本",
  "author": "ZTools Team",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "category": [
    "办公工具",
    "效率工具"
  ],
  "permissions": [
    "fs",
    "shell",
    "dialog"
  ],
  "requireAdmin": false,
  "nativeComponents": [],
  "features": [
    {
      "code": "office-slim-workbench",
      "explain": "重新压缩 Office 文档结构，图片保持原字节，另存新副本",
      "cmds": [
        "文档瘦身",
        "ppt压缩",
        "word压缩",
        "excel压缩",
        "压缩文档",
        "office slim"
      ]
    },
    {
      "code": "office-extract-images",
      "explain": "把文档内嵌原图导出为 ZIP 压缩包",
      "cmds": [
        "提取ppt图片",
        "导出word图片",
        "提取文档图片",
        "extract doc images"
      ]
    },
    {
      "code": "office-clean-metadata",
      "explain": "移除作者属性与批注，保留正文及修订内容，另存新副本",
      "cmds": [
        "清除文档隐私",
        "擦除作者信息",
        "删除批注痕迹",
        "clean office metadata"
      ]
    }
  ],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "minAppVersion": "1.1.8.5"
}
