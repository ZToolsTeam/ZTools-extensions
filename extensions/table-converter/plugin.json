{
  "id": "table-converter",
  "name": "表格互转",
  "version": "1.0.5",
  "description": "离线转换 Excel 复制文本/TSV/CSV、JSON 数组、Markdown、HTML 文字表格与 SQLite INSERT，保留长数字和 JSON 类型，回车复制",
  "author": "ZTools Team",
  "category": [
    "办公效率"
  ],
  "categoryId": "productivity",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "permissions": [
    "clipboard"
  ],
  "nativeComponents": [],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "features": [
    {
      "code": "table-auto",
      "explain": "自动识别剪贴板数据并转为 Markdown 表格、JSON、SQL 或 HTML",
      "cmds": [
        "表格转换",
        "excel转markdown",
        "csv转json",
        "table",
        "表格互转"
      ]
    },
    {
      "code": "table-to-markdown",
      "explain": "将剪贴板的 Excel/TSV/CSV 快速转为对齐美化的 Markdown 表格",
      "cmds": [
        "转markdown表格",
        "excel转md",
        "csv2md"
      ]
    },
    {
      "code": "table-to-json",
      "explain": "将剪贴板表格数据转为结构化 JSON 对象数组",
      "cmds": [
        "表格转json",
        "csv转json数组",
        "csv2json"
      ]
    },
    {
      "code": "table-to-sql",
      "explain": "将表格数据生成批量 SQL INSERT INTO 语句",
      "cmds": [
        "表格转sql",
        "csv转insert",
        "生成sql"
      ]
    }
  ],
  "defaultLocale": "zh-CN",
  "i18n": {
    "en-US": {
      "name": "Table Format Converter",
      "description": "Convert offline between Excel/TSV/CSV, JSON arrays, Markdown tables, HTML tables, and SQLite INSERT statements while preserving long numbers and JSON types.",
      "keywords": [
        "table",
        "csv",
        "tsv",
        "excel",
        "markdown",
        "json",
        "sql",
        "converter"
      ],
      "features": {
        "table-auto": {
          "explain": "Auto-detect clipboard table data and convert to Markdown, JSON, SQL, or HTML",
          "cmds": [
            "table",
            "table convert",
            "excel to markdown",
            "csv to json"
          ]
        },
        "table-to-markdown": {
          "explain": "Convert clipboard Excel, TSV, or CSV data into aligned Markdown tables",
          "cmds": [
            "to markdown table",
            "excel to md",
            "csv2md"
          ]
        },
        "table-to-json": {
          "explain": "Convert clipboard tabular data into structured JSON object arrays",
          "cmds": [
            "table to json",
            "csv to json",
            "csv2json"
          ]
        },
        "table-to-sql": {
          "explain": "Generate batch SQL INSERT INTO statements from tabular data",
          "cmds": [
            "table to sql",
            "csv to sql",
            "generate sql insert"
          ]
        }
      },
      "screenshots": [
        {
          "file": "screenshots/en-US/01.png"
        }
      ]
    }
  },
  "screenshots": [
    {
      "path": "screenshots/01-overview.png"
    },
    {
      "path": "screenshots/02-action-panel.png"
    }
  ]
}
