{
  "id": "google-auth",
  "name": "2FA 验证码",
  "version": "1.0.9",
  "description": "桌面端两步验证动态口令（TOTP）管理工具，支持秒级复制 6 位验证码，密钥加密保存在本机",
  "author": "ZTools Team",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "permissions": [
    "clipboard",
    "crypto"
  ],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "nativeComponents": [],
  "keywords": [
    "2fa",
    "totp",
    "otp",
    "验证码",
    "动态口令",
    "authenticator"
  ],
  "category": [
    "安全隐私"
  ],
  "categoryId": "security",
  "defaultLocale": "zh-CN",
  "i18n": {
    "en-US": {
      "name": "2FA Authenticator",
      "description": "Desktop two-factor authentication (TOTP) manager with one-click 6-digit code copy and locally encrypted secret storage.",
      "keywords": [
        "2fa",
        "totp",
        "otp",
        "authenticator",
        "security",
        "codes"
      ]
    }
  }
}
