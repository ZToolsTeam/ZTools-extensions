{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@ztools/declarative-ui": ["../../packages/declarative-ui/dist/index.d.ts"]
    },
    "typeRoots": [
      "../../electron-client/node_modules/@types",
      "../../node_modules/@types"
    ],
    "types": ["node"]
  },
  "include": ["src/**/*"]
}
