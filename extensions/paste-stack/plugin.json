{
  "id": "paste-stack",
  "name": "纯文本与粘贴栈",
  "version": "1.0.10",
  "description": "一键清除剪贴板富文本脏格式转为纯文本；支持多项连续复制入栈、跨窗口依次顺序或倒序自动上屏粘贴",
  "author": "ZTools Team",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "category": [
    "办公效率"
  ],
  "categoryId": "productivity",
  "permissions": [
    "clipboard"
  ],
  "requireAdmin": false,
  "nativeComponents": [],
  "features": [
    {
      "code": "paste-stack-queue",
      "explain": "查看与管理当前粘贴栈队列，开启/关闭连续复制入栈监听",
      "cmds": [
        "粘贴栈",
        "连续复制粘贴",
        "顺序粘贴",
        "队列粘贴",
        "paste stack"
      ]
    },
    {
      "code": "paste-clean-text",
      "explain": "清除当前剪贴板富文本格式，保留路径、代码、空格与换行原文",
      "cmds": [
        "清除格式",
        "纯文本粘贴",
        "洗纯文本",
        "剪贴板清洗",
        "clean clipboard text"
      ],
      "mode": "no-view"
    },
    {
      "code": "paste-stack-fifo",
      "explain": "按先进先出顺序查看与使用粘贴栈",
      "cmds": [
        "开启先进先出",
        "顺序粘贴模式",
        "fifo paste"
      ]
    },
    {
      "code": "paste-stack-lifo",
      "explain": "按后进先出顺序查看与使用粘贴栈",
      "cmds": [
        "开启后进先出",
        "倒序粘贴模式",
        "lifo paste"
      ]
    }
  ],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "minAppVersion": "1.1.8.3",
  "defaultLocale": "zh-CN",
  "i18n": {
    "en-US": {
      "name": "Plain Text & Paste Stack",
      "description": "Strip rich formatting from clipboard text with one click, or collect multiple copies into a FIFO/LIFO paste queue for sequential pasting across windows.",
      "keywords": [
        "paste stack",
        "clipboard",
        "plain text",
        "fifo",
        "lifo",
        "queue"
      ],
      "features": {
        "paste-stack-queue": {
          "explain": "View and manage the paste stack queue and toggle copy-capture mode",
          "cmds": [
            "paste stack",
            "paste queue",
            "multi copy",
            "sequential paste"
          ]
        },
        "paste-clean-text": {
          "explain": "Strip rich formatting from clipboard text while keeping raw code, paths, and whitespace",
          "cmds": [
            "clean clipboard text",
            "plain text",
            "strip format",
            "unformatted paste"
          ]
        },
        "paste-stack-fifo": {
          "explain": "Open and use the paste stack in first-in, first-out (FIFO) order",
          "cmds": [
            "fifo paste",
            "fifo stack",
            "order paste"
          ]
        },
        "paste-stack-lifo": {
          "explain": "Open and use the paste stack in last-in, first-out (LIFO) order",
          "cmds": [
            "lifo paste",
            "lifo stack",
            "reverse paste"
          ]
        }
      }
    }
  }
}
