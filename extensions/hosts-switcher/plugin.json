{
  "id": "hosts-switcher",
  "name": "域名映射",
  "version": "1.0.7",
  "description": "保存并切换多套 Hosts 方案；Mac 写入前预览、校验和备份，通过系统授权应用并支持恢复",
  "author": "ZTools Team",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "nativeComponents": [],
  "targets": [
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "permissions": [
    "fs",
    "system"
  ],
  "features": [
    {
      "code": "hosts-all",
      "explain": "查看全部 Hosts 方案、当前激活状态与系统 hosts 合并预览",
      "cmds": [
        "hosts",
        "hosts切换",
        "域名映射",
        "switchhosts",
        "dns映射"
      ]
    },
    {
      "code": "hosts-flush-dns",
      "explain": "经系统授权刷新本机 DNS 解析缓存",
      "cmds": [
        "刷新dns",
        "flushdns",
        "清理dns缓存"
      ]
    },
    {
      "code": "hosts-new-profile",
      "explain": "新建一套自定义 Hosts 环境映射方案",
      "cmds": [
        "新建hosts方案",
        "添加hosts",
        "添加域名映射"
      ]
    }
  ],
  "minAppVersion": "1.1.8.5"
}
