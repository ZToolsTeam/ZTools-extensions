{
  "id": "media-metadata",
  "name": "EXIF隐私抹除",
  "version": "1.0.3",
  "description": "本地读取照片与音视频元数据，清理照片定位及拍摄信息，校验图像数据后另存新副本",
  "author": "ZTools Community",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "permissions": [
    "fs",
    "dialog"
  ],
  "nativeComponents": [],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "features": [
    {
      "code": "media-metadata-workbench",
      "explain": "选择照片或音视频，查看真实元数据并清理照片副本",
      "cmds": [
        "exif查看",
        "清除照片隐私",
        "删除gps定位",
        "照片信息",
        "exif",
        "mediainfo"
      ]
    },
    {
      "code": "media-clean-gps-fast",
      "explain": "选择照片，清理已识别的定位标签并另存副本",
      "cmds": [
        "清除gps",
        "抹除照片位置",
        "删除拍照定位"
      ]
    },
    {
      "code": "media-stream-info",
      "explain": "读取音视频的格式、编码、帧率等已有元数据",
      "cmds": [
        "视频参数查看",
        "查看视频编码",
        "视频帧率",
        "音频参数"
      ]
    }
  ],
  "minAppVersion": "1.1.8.5"
}
