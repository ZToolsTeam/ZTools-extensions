{
  "id": "lan-share",
  "name": "局域网传文件",
  "description": "选择电脑上的文件或文件夹开启局域网共享，同一网络的手机或电脑用浏览器打开本机地址或扫码即可下载；共享不需要密码，只支持从电脑下载，不支持从手机上传",
  "version": "2.0.14",
  "author": "ZTools Team",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "category": [
    "网络工具",
    "办公效率"
  ],
  "categoryId": [
    "network",
    "productivity"
  ],
  "permissions": [
    "network",
    "fs",
    "dialog",
    "clipboard"
  ],
  "requireAdmin": false,
  "nativeComponents": [],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "defaultLocale": "zh-CN",
  "i18n": {
    "en-US": {
      "name": "LAN File Share",
