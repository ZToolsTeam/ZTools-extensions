{
  "id": "wechat-cleaner",
  "name": "微信清理",
  "description": "扫描微信电脑版的缓存、日志、聊天视频与图片、接收文件等，把勾选的文件移入回收站，聊天记录数据库不会被清理",
  "version": "2.0.11",
  "author": "ZTools Team",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "category": [
    "系统工具"
  ],
  "categoryId": "system",
  "permissions": [
    "fs",
    "shell",
    "clipboard"
  ],
  "requireAdmin": false,
  "nativeComponents": [],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "minAppVersion": "1.1.8.9",
  "defaultLocale": "zh-CN",
  "i18n": {
    "en-US": {
      "name": "WeChat Cleaner",
      "description": "Scan desktop WeChat caches, logs, chat images/videos, and received files, moving selected items to the Recycle Bin without touching chat databases.",
      "keywords": [
        "wechat",
        "cleaner",
        "cache",
        "cleanup",
        "recycle bin",
        "storage"
      ]
    }
  }
}
