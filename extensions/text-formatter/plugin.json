{
  "id": "text-formatter",
  "name": "文本排版",
  "version": "1.0.6",
  "description": "中英文混排自动加空格、中英标点互转、全半角转换、大小写转换与清除多余空行空白",
  "author": "ZTools Team",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "permissions": [
    "clipboard"
  ],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "nativeComponents": []
}
