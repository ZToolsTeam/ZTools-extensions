{
  "id": "browser-bookmarks",
  "name": "网页书签",
  "version": "1.0.5",
  "description": "只读聚合本机浏览器的多个配置，支持中文、拼音、网址与文件夹检索，打开或复制书签；无法读取的来源会明确提示",
  "author": "ZTools Team",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "category": [
    "网络工具"
  ],
  "categoryId": "network",
  "permissions": [
    "fs",
    "shell",
    "clipboard"
  ],
  "requireAdmin": false,
  "nativeComponents": [],
  "features": [
    {
      "code": "bookmarks-all",
      "explain": "聚合检索全部浏览器的收藏网页书签",
      "cmds": [
        "网页书签",
        "书签",
        "浏览器书签",
        "收藏夹",
        "bookmarks",
        "搜索书签"
      ]
    },
    {
      "code": "bookmarks-edge",
      "explain": "仅筛选检索 Microsoft Edge 浏览器的收藏书签",
      "cmds": [
        "Edge书签",
        "微软书签",
        "edge bookmarks"
      ]
    },
    {
      "code": "bookmarks-chrome",
      "explain": "仅筛选检索 Google Chrome 浏览器的收藏书签",
      "cmds": [
        "Chrome书签",
        "谷歌书签",
        "chrome bookmarks"
      ]
    },
    {
      "code": "bookmarks-domestic",
      "explain": "筛选检索 QQ 浏览器与 360 极速浏览器书签（Windows 上另含 360 安全浏览器）",
      "cmds": [
        "360书签",
        "QQ浏览器书签",
        "国产浏览器书签"
      ]
    },
    {
      "code": "bookmarks-firefox",
      "explain": "筛选检索 Mozilla Firefox 火狐浏览器的收藏书签",
      "cmds": [
        "Firefox书签",
        "火狐书签",
        "firefox bookmarks"
      ]
    }
  ],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "defaultLocale": "zh-CN",
  "i18n": {
    "en-US": {
      "name": "Browser Bookmarks",
      "description": "Read-only search across multiple local browser profiles by title, pinyin, URL, or folder to open or copy bookmarks, with clear notices for unreadable sources.",
      "keywords": [
        "bookmarks",
        "browser",
        "chrome",
        "edge",
        "firefox",
        "favorites",
        "search"
      ],
      "features": {
        "bookmarks-all": {
          "explain": "Search bookmarks across all detected local browsers",
          "cmds": [
            "bookmarks",
            "browser bookmarks",
            "search bookmarks",
            "favorites"
          ]
        },
        "bookmarks-edge": {
          "explain": "Search bookmarks from Microsoft Edge only",
          "cmds": [
            "edge bookmarks",
            "microsoft edge bookmarks"
          ]
        },
        "bookmarks-chrome": {
          "explain": "Search bookmarks from Google Chrome only",
          "cmds": [
            "chrome bookmarks",
            "google chrome bookmarks"
          ]
        },
        "bookmarks-domestic": {
          "explain": "Search bookmarks from QQ Browser and 360 Browser",
          "cmds": [
            "qq bookmarks",
            "360 bookmarks",
            "chinese browser bookmarks"
          ]
        },
        "bookmarks-firefox": {
          "explain": "Search bookmarks from Mozilla Firefox only",
          "cmds": [
            "firefox bookmarks",
            "mozilla bookmarks"
          ]
        }
      },
      "screenshots": [
        {
          "file": "screenshots/en-US/01.png"
        }
      ]
    }
  },
  "screenshots": [
    {
      "path": "screenshots/01.png"
    }
  ]
}
