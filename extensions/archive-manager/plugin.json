{
  "id": "archive-manager",
  "name": "解压与压缩",
  "description": "选择或拖入 ZIP 压缩包直接查看包内文件，可整包解压或只提取勾选的文件；只支持 ZIP，不提供压缩打包",
  "version": "1.1.11",
  "author": "ZTools Team",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "alias": "zip",
  "category": [
    "文件管理",
    "办公效率"
  ],
  "categoryId": [
    "files",
    "productivity"
  ],
  "keywords": [
    "zip",
    "archive",
    "unzip",
    "extract",
    "解压",
    "压缩包",
    "查看压缩包"
  ],
  "features": [
    {
      "code": "archive-inspect",
      "explain": "查看 ZIP 压缩包内容并解压或提取",
      "mode": "view",
      "cmds": [
        "解压",
        "压缩包",
        "查看压缩包",
        "zip",
        "校验压缩包"
      ]
    },
    {
      "code": "archive-docs",
      "explain": "提取压缩包内办公文档",
      "mode": "view",
      "cmds": [
        "提取文档",
        "压缩包文档"
      ]
    }
  ],
  "permissions": [
    "fs",
    "dialog",
    "clipboard",
    "shell"
  ],
  "requireAdmin": false,
  "nativeComponents": [],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "minAppVersion": "1.1.8.9",
  "defaultLocale": "zh-CN",
  "i18n": {
    "en-US": {
      "name": "ZIP Archive Manager",
      "description": "Select or drop ZIP archives to browse contents and extract all or selected files. Supports ZIP inspection and extraction only (no archive creation).",
      "keywords": [
        "zip",
        "archive",
        "unzip",
        "extract",
        "decompress",
        "files"
      ],
      "features": {
        "archive-inspect": {
          "explain": "Browse ZIP archive contents and extract all or selected files",
          "cmds": [
            "unzip",
            "zip",
            "archive",
            "extract zip",
            "inspect zip"
          ]
        },
        "archive-docs": {
          "explain": "Extract office documents from a ZIP archive",
          "cmds": [
            "extract docs",
            "archive docs",
            "unzip documents"
          ]
        }
      }
    }
  }
}
