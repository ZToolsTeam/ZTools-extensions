{
  "id": "monitor-control",
  "name": "屏幕亮度与控制",
  "version": "1.0.6",
  "description": "读取显示器真实硬件状态，调节受支持的亮度与对比度；支持多屏统一亮度与系统熄屏命令",
  "author": "ZTools Team",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "category": [
    "系统工具",
    "效率工具"
  ],
  "permissions": [
    "screen",
    "system"
  ],
  "requireAdmin": false,
  "nativeComponents": [],
  "features": [
    {
      "code": "monitor-brightness",
      "explain": "调节内置与外接显示器硬件亮度与对比度；熄屏请使用“熄屏”命令",
      "cmds": [
        "亮度",
        "显示器",
        "屏幕亮度",
        "brightness",
        "monitor",
        "ddc"
      ]
    },
    {
      "code": "monitor-sleep",
      "explain": "请求系统关闭显示器；是否锁屏取决系统设置",
      "cmds": [
        "熄屏",
        "关闭屏幕",
        "关屏",
        "sleep monitor",
        "turn off screen"
      ],
      "mode": "no-view"
    }
  ],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "minAppVersion": "1.1.8.5"
}
