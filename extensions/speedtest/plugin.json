{
  "id": "speedtest",
  "name": "网络测速",
  "version": "1.1.8",
  "description": "测量上下行吞吐量，检测默认网关与国内、国际节点连接；Mac 使用系统网络测速工具",
  "author": "ZTools Team",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "category": [
    "网络工具",
    "系统工具"
  ],
  "categoryId": [
    "network",
    "system"
  ],
  "permissions": [
    "network",
    "system",
    "clipboard"
  ],
  "requireAdmin": false,
  "nativeComponents": [],
  "features": [
    {
      "code": "speedtest-full",
      "explain": "测量真实上传与下载吞吐量，查看网络延迟与负载响应",
      "cmds": [
        "网络测速",
        "测网速",
        "宽带测速",
        "speedtest",
        "网速测试"
      ]
    },
    {
      "code": "speedtest-ping-check",
      "explain": "检测默认网关、国内网站与 GitHub、Cloudflare 的连接和延迟",
      "cmds": [
        "网络诊断",
        "检查网络",
        "ping测试",
        "网络延迟"
      ]
    }
  ],
  "targets": [
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "minAppVersion": "1.1.8.5",
  "defaultLocale": "zh-CN",
  "i18n": {
    "en-US": {
      "name": "Network Speed Test",
      "description": "Measure upload and download throughput and check connectivity to default gateway, domestic, and global hosts (uses Apple networkQuality on macOS).",
      "keywords": [
        "speedtest",
        "bandwidth",
        "ping",
        "latency",
        "network",
        "throughput"
      ],
      "features": {
        "speedtest-full": {
          "explain": "Measure real upload/download throughput, latency, and responsiveness",
          "cmds": [
            "speedtest",
            "speed test",
            "bandwidth test",
            "network speed"
          ]
        },
        "speedtest-ping-check": {
          "explain": "Check connectivity and latency to gateway, domestic sites, GitHub, and Cloudflare",
          "cmds": [
            "ping test",
            "network check",
            "latency check",
            "diagnose network"
          ]
        }
      },
      "screenshots": [
        {
          "file": "screenshots/en-US/01.png"
        }
      ]
    }
  },
  "screenshots": [
    {
      "path": "screenshots/01-overview.png"
    },
    {
      "path": "screenshots/02-action-panel.png"
    }
  ]
}
