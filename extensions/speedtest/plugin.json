{
  "id": "speedtest",
  "name": "网络测速",
  "version": "1.1.5",
  "description": "测量上下行吞吐量，检测默认网关与国内、国际节点连接；Mac 使用系统网络测速工具",
  "author": "ZTools Community",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "category": [
    "网络工具",
    "系统工具"
  ],
  "permissions": [
    "network",
    "system",
    "clipboard"
  ],
  "requireAdmin": false,
  "nativeComponents": [],
  "features": [
    {
      "code": "speedtest-full",
      "explain": "测量真实上传与下载吞吐量，查看网络延迟与负载响应",
      "cmds": [
        "网络测速",
        "测网速",
        "宽带测速",
        "speedtest",
        "网速测试"
      ]
    },
    {
      "code": "speedtest-ping-check",
      "explain": "检测默认网关、国内网站与 GitHub、Cloudflare 的连接和延迟",
      "cmds": [
        "网络诊断",
        "检查网络",
        "ping测试",
        "网络延迟"
      ]
    }
  ],
  "targets": [
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "minAppVersion": "1.1.8.5"
}
