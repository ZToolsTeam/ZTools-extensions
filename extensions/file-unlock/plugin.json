{
  "id": "file-unlock",
  "name": "文件解锁",
  "description": "检测文件、文件夹和外接磁盘的真实进程占用，确认后结束进程，支持不覆盖改名和系统回收站恢复",
  "version": "1.0.4",
  "author": "ZTools Community",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "category": [
    "系统工具",
    "效率工具"
  ],
  "permissions": [
    "fs",
    "system",
    "clipboard",
    "shell",
    "process"
  ],
  "requireAdmin": false,
  "nativeComponents": [],
  "features": [
    {
      "code": "file-unlock",
      "explain": "检测文件占用，确认后结束进程或移入系统回收站",
      "cmds": [
        "文件解锁",
        "解除占用",
        "unlock",
        "无法删除",
        "文件被占用",
        "谁占用了"
      ]
    },
    {
      "code": "usb-unlock",
      "explain": "检测 U 盘或移动硬盘被哪个后台进程占用导致无法安全弹出",
      "cmds": [
        "U盘解锁",
        "弹出U盘",
        "无法弹出",
        "移动硬盘占用",
        "eject"
      ]
    }
  ],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ]
}
