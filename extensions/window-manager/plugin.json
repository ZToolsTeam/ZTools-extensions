{
  "id": "window-manager",
  "name": "窗口管理",
  "description": "管理活动窗口的半屏、四角、三分屏、居中与跨显示器移动",
  "version": "2.0.10",
  "author": "ZTools Team",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "category": [
    "系统工具",
    "办公效率"
  ],
  "keywords": [
    "窗口管理",
    "窗口分屏",
    "左右分屏",
    "窗口居中",
    "多显示器",
    "window"
  ],
  "features": [
    {
      "code": "win-snap-half",
      "explain": "窗口左右分屏贴靠与居中排版",
      "cmds": [
        "窗口分屏",
        "左右分屏",
        "左半屏",
        "右半屏",
        "窗口居中"
      ]
    },
    {
      "code": "win-display",
      "explain": "将活动窗口移动到上一或下一显示器",
      "cmds": [
        "移动窗口",
        "下一显示器",
        "上一显示器"
      ]
    }
  ],
  "permissions": [
    "system",
    "screen"
  ],
  "requireAdmin": false,
  "nativeComponents": [],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "minAppVersion": "1.1.8.9"
}
