{
  "id": "md-to-office",
  "name": "AI文档转Word",
  "version": "1.0.3",
  "description": "本地将 Markdown 文本或文件转换为 Word 新副本，保留标题、列表、表格和代码块，支持公文、商务和学术排版及富文本复制",
  "author": "ZTools Community",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "permissions": [
    "clipboard",
    "fs",
    "dialog"
  ],
  "nativeComponents": [],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "features": [
    {
      "code": "md-to-office-workbench",
      "explain": "读取剪贴板、打开或编辑 Markdown，选择排版后另存 Word 新副本",
      "cmds": [
        "md转word",
        "ai转word",
        "markdown转word",
        "deepseek转word",
        "导出word",
        "md to docx"
      ]
    },
    {
      "code": "md-to-office-clipboard-fast",
      "explain": "读取剪贴板 Markdown，按公文风格转换并复制为富文本",
      "cmds": [
        "复制为word格式",
        "剪贴板转word",
        "快速排版粘贴"
      ]
    }
  ],
  "minAppVersion": "1.1.8.5"
}
