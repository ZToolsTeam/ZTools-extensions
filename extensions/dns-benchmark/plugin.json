{
  "id": "dns-benchmark",
  "name": "DNS测速",
  "version": "1.0.4",
  "description": "测试公共 DNS 地址的响应情况，切换当前网络 DNS；Mac 支持真实域名解析、配置备份与恢复",
  "author": "ZTools Community",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "category": [
    "网络工具",
    "系统工具"
  ],
  "permissions": [
    "network",
    "system",
    "clipboard"
  ],
  "requireAdmin": false,
  "nativeComponents": [],
  "features": [
    {
      "code": "dns-benchmark-run",
      "explain": "测量公共 DNS 地址并选择应用",
      "cmds": [
        "DNS测速",
        "切换DNS",
        "修改DNS",
        "dns",
        "dns jumper",
        "最快dns"
      ]
    },
    {
      "code": "dns-flush-cache",
      "explain": "刷新系统 DNS 解析缓存，需要系统授权",
      "cmds": [
        "刷新DNS",
        "清空DNS缓存",
        "flushdns"
      ]
    },
    {
      "code": "dns-reset-dhcp",
      "explain": "将当前网络恢复为自动获取 DNS",
      "cmds": [
        "恢复默认DNS",
        "自动获取DNS",
        "重置DNS"
      ]
    }
  ],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ]
}
