{
  "id": "sql-helper",
  "name": "SQL格式化转换",
  "version": "1.0.1",
  "description": "SQL美化与精简、MyBatis日志参数核对、CREATE TABLE转TypeScript/Go/Java模型；支持多行编辑与剪贴板输入",
  "author": "ZTools Community",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "nativeComponents": [],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "permissions": [
    "clipboard"
  ],
  "features": [
    {
      "code": "sql-formatter",
      "explain": "SQL分句排版与精简空白，保留标识符、字符串、注释和必要换行",
      "cmds": [
        "sql格式化",
        "sql美化",
        "sql压缩",
        "format sql",
        "美化sql"
      ]
    },
    {
      "code": "mybatis-merge",
      "explain": "核对同一次调用的Preparing与Parameters，生成参数还原参考SQL",
      "cmds": [
        "mybatis日志",
        "mybatis还原",
        "mybatis sql",
        "参数拼合",
        "sql问号替换"
      ]
    },
    {
      "code": "ddl-to-entity",
      "explain": "粘贴 CREATE TABLE 建表语句，一键生成 TypeScript / Go / Java 实体模型代码",
      "cmds": [
        "ddl转实体",
        "sql转实体",
        "建表转java",
        "sql转ts",
        "sql转go",
        "create table转实体"
      ]
    }
  ]
}
