{
  "id": "sql-helper",
  "name": "SQL格式化转换",
  "version": "1.0.4",
  "description": "SQL美化与精简、MyBatis日志参数核对、CREATE TABLE转TypeScript/Go/Java模型；支持多行编辑与剪贴板输入",
  "author": "ZTools Team",
  "category": [
    "开发工具"
  ],
  "categoryId": "developer",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "nativeComponents": [],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "permissions": [
    "clipboard"
  ],
  "features": [
    {
      "code": "sql-formatter",
      "explain": "SQL分句排版与精简空白，保留标识符、字符串、注释和必要换行",
      "cmds": [
        "sql格式化",
        "sql美化",
        "sql压缩",
        "format sql",
        "美化sql"
      ]
    },
    {
      "code": "mybatis-merge",
      "explain": "核对同一次调用的Preparing与Parameters，生成参数还原参考SQL",
      "cmds": [
        "mybatis日志",
        "mybatis还原",
        "mybatis sql",
        "参数拼合",
        "sql问号替换"
      ]
    },
    {
      "code": "ddl-to-entity",
      "explain": "粘贴 CREATE TABLE 建表语句，一键生成 TypeScript / Go / Java 实体模型代码",
      "cmds": [
        "ddl转实体",
        "sql转实体",
        "建表转java",
        "sql转ts",
        "sql转go",
        "create table转实体"
      ]
    }
  ],
  "defaultLocale": "zh-CN",
  "i18n": {
    "en-US": {
      "name": "SQL Formatter & Converter",
      "description": "Format or minify SQL queries safely, merge MyBatis Preparing/Parameters logs into runnable SQL, and convert CREATE TABLE DDL to TypeScript, Go, or Java models.",
      "keywords": [
        "sql",
        "format",
        "minify",
        "mybatis",
        "ddl",
        "entity",
        "codegen"
      ],
      "features": {
        "sql-formatter": {
          "explain": "Format or minify SQL while preserving identifiers, strings, and comments",
          "cmds": [
            "format sql",
            "sql formatter",
            "beautify sql",
            "minify sql"
          ]
        },
        "mybatis-merge": {
          "explain": "Merge MyBatis Preparing and Parameters logs into reconstructed SQL",
          "cmds": [
            "mybatis",
            "mybatis sql",
            "merge sql params",
            "mybatis log"
          ]
        },
        "ddl-to-entity": {
          "explain": "Convert CREATE TABLE DDL statements into TypeScript, Go, or Java entity models",
          "cmds": [
            "ddl to entity",
            "sql to ts",
            "sql to go",
            "sql to java",
            "create table"
          ]
        }
      },
      "screenshots": [
        {
          "file": "screenshots/en-US/01.png"
        }
      ]
    }
  },
  "screenshots": [
    {
      "path": "screenshots/01-overview.png"
    },
    {
      "path": "screenshots/02-action-panel.png"
    },
    {
      "path": "screenshots/03-interactive.png"
    }
  ]
}
