{
  "id": "clipboard-manager",
  "name": "剪贴板历史",
  "description": "自动记录复制过的文本、图片与文件历史，支持关键词搜索、置顶收藏与一键粘贴",
  "version": "2.0.5",
  "author": "ZTools Team",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "category": "system",
  "permissions": [
    "clipboard"
  ],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "nativeComponents": []
}
