{
  "id": "hotkey-radar",
  "name": "热键侦测",
  "version": "1.0.6",
  "description": "检测全局快捷键注册情况，离线查询系统与常用软件快捷键；Mac 区分 ⌘ 与 ⌃，不推测占用进程",
  "author": "ZTools Team",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "category": [
    "系统工具",
    "效率工具"
  ],
  "permissions": ["system", "clipboard"],
  "requireAdmin": false,
  "nativeComponents": [],
  "features": [
    {
      "code": "hotkey-conflict-radar",
      "explain": "检测全局快捷键注册情况，帮助排查冲突",
      "cmds": [
        "热键侦测",
        "热键冲突",
        "快捷键冲突",
        "谁占用了快捷键",
        "hotkey"
      ]
    },
    {
      "code": "hotkey-cheatsheet",
      "explain": "离线速查当前系统（Windows 或 macOS）及 VS Code、Excel、Photoshop、浏览器的默认快捷键",
      "cmds": [
        "快捷键速查",
        "常用快捷键",
        "excel快捷键",
        "vscode快捷键",
        "windows快捷键"
      ]
    }
  ],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "minAppVersion": "1.1.8.5"
}
