{
  "id": "batch-text-convert",
  "name": "编码转换",
  "description": "把文本实时转为 Unicode 转义（\\uXXXX）、UTF-8 十六进制（Hex）、Base64 与 URL 编码，可读取剪贴板里的多行文本",
  "version": "1.0.1",
  "author": "ZTools Team",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "category": "developer",
  "permissions": [
    "fs",
    "clipboard"
  ],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "nativeComponents": [],
  "keywords": [
    "unicode",
    "hex",
    "十六进制",
    "utf-8",
    "utf8",
    "base64",
    "url",
    "urlencode",
    "url编码",
    "百分号编码",
    "转义",
    "编码"
  ]
}
