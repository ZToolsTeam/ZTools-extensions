    {
      "code": "clean-keyboard",
      "explain": "锁定键盘输入以便擦拭清洁键盘，倒计时结束自动恢复输入",
      "cmds": [
        "清洁键盘",
        "锁键盘",
        "擦键盘",
        "键盘锁",
        "clean keyboard",
        "lock keyboard"
      ]
    }
  ],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ]
}
