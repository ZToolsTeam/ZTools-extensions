{
  "id": "clean-keyboard",
  "name": "键盘清洁锁",
  "version": "1.0.5",
  "description": "Mac 系统键盘清洁锁，可同时拦截鼠标，支持 5～300 秒倒计时、紧急解锁与失联自动解除",
  "author": "ZTools Team",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "category": [
    "系统工具"
  ],
  "categoryId": "system",
  "permissions": [
    "system"
  ],
  "requireAdmin": false,
  "nativeComponents": [],
  "features": [
    {
      "code": "clean-keyboard",
      "explain": "锁定键盘输入以便擦拭清洁键盘，倒计时结束自动恢复输入",
      "cmds": [
        "清洁键盘",
        "锁键盘",
        "擦键盘",
        "键盘锁",
        "clean keyboard",
        "lock keyboard"
      ]
    }
  ],
  "targets": [
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "defaultLocale": "zh-CN",
  "i18n": {
    "en-US": {
      "name": "Keyboard Cleaning Lock",
      "description": "Lock your Mac keyboard (and optionally mouse) for safe cleaning with a 5 to 300 second countdown, emergency unlock, and automatic failsafe release.",
      "keywords": [
        "keyboard lock",
        "clean keyboard",
        "disable keyboard",
        "macos",
        "lock input"
      ],
      "features": {
        "clean-keyboard": {
          "explain": "Lock keyboard input for cleaning with automatic unlock after countdown",
          "cmds": [
            "clean keyboard",
            "lock keyboard",
            "keyboard lock",
            "disable keyboard"
          ]
        }
      },
      "screenshots": [
        {
          "file": "screenshots/en-US/01.png"
        }
      ]
    }
  },
  "screenshots": [
    {
      "path": "screenshots/01.png"
    }
  ]
}
