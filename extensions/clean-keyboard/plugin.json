{
  "id": "clean-keyboard",
  "name": "键盘清洁锁",
  "version": "1.0.2",
  "description": "Mac 系统键盘清洁锁，可同时拦截鼠标，支持 5～300 秒倒计时、紧急解锁与失联自动解除",
  "author": "ZTools Community",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "category": [
    "系统工具",
    "效率工具"
  ],
  "permissions": [
    "system"
  ],
  "requireAdmin": false,
  "nativeComponents": [],
  "features": [
    {
      "code": "clean-keyboard",
      "explain": "锁定键盘输入以便擦拭清洁键盘，倒计时结束自动恢复输入",
      "cmds": [
        "清洁键盘",
        "锁键盘",
        "擦键盘",
        "键盘锁",
        "clean keyboard",
        "lock keyboard"
      ]
    }
  ],
  "targets": [
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ]
}
