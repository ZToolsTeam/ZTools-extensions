{
  "id": "svg-icon-studio",
  "name": "SVG预览与压缩",
  "version": "1.0.3",
  "description": "静态 SVG 校验、清理与代码预览，保留文字和数值精度，导出 React TSX / Vue 3 SFC / Data URI",
  "author": "ZTools Community",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "nativeComponents": [],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "permissions": [
    "clipboard"
  ],
  "features": [
    {
      "code": "svg-icon-studio",
      "explain": "校验清理静态 SVG，预览并导出 React / Vue 组件或 Data URI",
      "cmds": [
        "svg",
        "svgo",
        "icon",
        "svg压缩",
        "图标转换",
        "SVG预览"
      ]
    }
  ]
}
