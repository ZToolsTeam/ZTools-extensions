{
  "id": "shutdown-timer",
  "name": "定时关机",
  "description": "按预设倒计时（10、30、60、120 分钟）自动关机，或立即锁屏、睡眠，设定关机前会先确认；插件不能取消已设定的关机，可复制取消命令自行运行",
  "version": "1.0.7",
  "author": "ZTools Team",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "category": [
    "系统工具"
  ],
  "categoryId": "system",
  "permissions": [
    "system"
  ],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "nativeComponents": [],
  "keywords": [
    "定时关机",
    "倒计时关机",
    "自动关机",
    "取消关机",
    "睡眠",
    "锁屏",
    "shutdown"
  ],
  "features": [
    {
      "code": "timer-shutdown",
      "explain": "按倒计时自动关机",
      "cmds": [
        "定时关机",
        "倒计时关机",
        "自动关机",
        "延时关机",
        "shutdown"
      ]
    },
    {
      "code": "power-now",
      "explain": "立即锁屏或睡眠",
      "cmds": [
        "锁屏",
        "睡眠"
      ]
    },
    {
      "code": "timer-cancel",
      "explain": "复制取消关机计划的命令",
      "cmds": [
        "取消关机",
        "取消定时关机",
        "停止关机"
      ]
    }
  ],
  "defaultLocale": "zh-CN",
  "i18n": {
    "en-US": {
      "name": "Shutdown Timer",
      "description": "Schedule automatic shutdown (10, 30, 60, or 120 minutes) after confirmation, or lock/sleep immediately, with a copyable cancel command.",
      "keywords": [
        "shutdown",
        "timer",
        "sleep",
        "lock",
        "power",
        "schedule"
      ],
      "features": {
        "timer-shutdown": {
          "explain": "Schedule automatic system shutdown by countdown",
          "cmds": [
            "shutdown",
            "shutdown timer",
            "auto shutdown",
            "delayed shutdown"
          ]
        },
        "power-now": {
          "explain": "Lock screen or put the computer to sleep immediately",
          "cmds": [
            "lock screen",
            "sleep now",
            "power"
          ]
        },
        "timer-cancel": {
          "explain": "Copy the command to cancel a scheduled shutdown",
          "cmds": [
            "cancel shutdown",
            "abort shutdown",
            "stop shutdown"
          ]
        }
      }
    }
  }
}
