{
  "id": "ocr",
  "name": "文字识别",
  "description": "框选屏幕、剪贴板或图片里的文字，在本机离线识别（OCR）简体中文、英文、日文、韩文，结果直接复制",
  "version": "3.0.8",
  "author": "ZTools Team",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "alias": "ocr",
  "category": [
    "办公效率"
  ],
  "categoryId": "productivity",
  "permissions": [
    "clipboard",
    "screen",
    "dialog",
    "fs",
    "shell",
    "notification"
  ],
  "requireAdmin": false,
  "nativeComponents": [],
  "features": [
    {
      "code": "ocr-region",
      "explain": "框选屏幕上的区域，识别其中的文字并复制",
      "mode": "no-view",
      "cmds": [
        "截图识别文字",
        "截图识字",
        "框选识字",
        "屏幕识字",
        "截图 OCR"
      ]
    },
    {
      "code": "ocr-clipboard",
      "explain": "识别剪贴板里的图片文字并复制",
      "mode": "no-view",
      "cmds": [
        "识别剪贴板图片",
        "剪贴板识字",
        "剪贴板 OCR"
      ]
    },
    {
      "code": "ocr-workbench",
      "explain": "添加图片批量识别，查看和复制识别结果",
      "cmds": [
        "文字识别",
        "图片识字",
        "图片转文字",
        "提取图片文字",
        "OCR"
      ]
    }
  ],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "minAppVersion": "1.1.8.9",
  "defaultLocale": "zh-CN",
  "i18n": {
    "en-US": {
      "name": "Offline Text OCR",
      "description": "Capture screen regions, clipboard images, or image files for offline OCR recognizing Simplified Chinese, English, Japanese, and Korean text with automatic copy.",
      "keywords": [
        "ocr",
        "text recognition",
        "screenshot",
        "extract text",
        "offline"
      ],
      "features": {
        "ocr-region": {
          "explain": "Select a screen region to recognize text and copy to clipboard",
          "cmds": [
            "ocr region",
            "screenshot ocr",
            "capture text",
            "screen ocr"
          ]
        },
        "ocr-clipboard": {
          "explain": "Recognize text from the current clipboard image and copy",
          "cmds": [
            "clipboard ocr",
            "paste ocr",
            "image clipboard text"
          ]
        },
        "ocr-workbench": {
          "explain": "Batch add images for offline OCR and copy recognized results",
          "cmds": [
            "ocr",
            "text ocr",
            "image to text",
            "extract text"
          ]
        }
      },
      "screenshots": [
        {
          "file": "screenshots/en-US/01.png"
        }
      ]
    }
  },
  "screenshots": [
    {
      "path": "screenshots/01-overview.png"
    },
    {
      "path": "screenshots/02-action-panel.png"
    }
  ]
}
