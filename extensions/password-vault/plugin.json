{
  "id": "password-vault",
  "name": "密码保险箱",
  "version": "1.1.4",
  "minAppVersion": "1.1.8.5",
  "description": "在本机用主密码加密保存账号密码、API Key、服务器密码与软件激活码（AES-256-GCM），复制密码 30 秒后自动清除剪贴板",
  "author": "ZTools Community",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "category": [
    "安全隐私",
    "效率工具"
  ],
  "permissions": [
    "crypto",
    "clipboard",
    "database"
  ],
  "requireAdmin": false,
  "nativeComponents": [],
  "features": [
    {
      "code": "vault-list",
      "explain": "解锁并搜索本地加密存储的账号密码、API Key、服务器密钥与私密备忘",
      "cmds": [
        "密码保险箱",
        "加密保险箱",
        "账号密码",
        "password vault",
        "1password",
        "keepass"
      ]
    },
    {
      "code": "vault-generator",
      "explain": "生成 20 位随机密码并复制，解锁后新建凭据时预先填入随机密码",
      "cmds": [
        "随机密码",
        "生成密码",
        "密码生成器"
      ]
    }
  ],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ]
}
