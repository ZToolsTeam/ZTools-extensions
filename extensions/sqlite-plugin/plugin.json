{
  "id": "sqlite-plugin",
  "name": "SQLite 查看器",
  "description": "选择、拖入或从文件夹导入 SQLite 数据库文件，记住最近打开记录，只读查看表结构与分页浏览记录，并导出为 CSV / JSON / SQL INSERT 文本",
  "version": "2.0.14",
  "minAppVersion": "1.1.8.7",
  "author": "ZTools Team",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "category": [
    "开发工具"
  ],
  "categoryId": "developer",
  "permissions": [
    "dialog",
    "sqlite",
    "fs",
    "system",
    "clipboard",
    "shell"
  ],
  "requireAdmin": false,
  "nativeComponents": [],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "features": [
    {
      "code": "sqlite-viewer",
      "explain": "只读查看 SQLite 数据库表结构与分页记录，支持导出 CSV / JSON / SQL",
      "mode": "view",
      "cmds": [
        "sqlite",
        "sqlite查看器",
        "数据库查看",
        "打开db",
        "查看sqlite"
      ]
    }
  ],
  "defaultLocale": "zh-CN",
  "i18n": {
    "en-US": {
      "name": "SQLite Viewer",
      "description": "Open SQLite database files via picker, folder, or drag-and-drop with persistent recent history, inspect table schemas, browse paginated rows, and export CSV, JSON, or SQL INSERT.",
      "keywords": [
        "sqlite",
        "database",
        "db",
        "viewer",
        "sql",
        "csv",
        "json"
      ],
      "features": {
        "sqlite-viewer": {
          "explain": "Inspect SQLite schemas and browse paginated table rows with CSV, JSON, and SQL export",
          "cmds": [
            "sqlite",
            "sqlite viewer",
            "db viewer",
            "open sqlite",
            "browse db"
          ]
        }
      },
      "screenshots": [
        {
          "file": "screenshots/en-US/01.png"
        }
      ]
    }
  },
  "screenshots": [
    {
      "path": "screenshots/01-overview.png"
    },
    {
      "path": "screenshots/02-action-panel.png"
    }
  ]
}
