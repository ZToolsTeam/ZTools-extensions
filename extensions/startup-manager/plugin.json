{
  "id": "startup-manager",
  "name": "启动管理",
  "description": "查看启动应用、后台服务与计划任务，管理自启状态；Mac 修改前保留可恢复的配置记录",
  "version": "1.0.9",
  "author": "ZTools Team",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "category": [
    "系统工具"
  ],
  "categoryId": "system",
  "permissions": [
    "system",
    "shell",
    "process",
    "clipboard",
    "fs"
  ],
  "requireAdmin": false,
  "nativeComponents": [],
  "features": [
    {
      "code": "startup-all",
      "explain": "聚合管理所有开机自启应用、第三方后台服务与开机计划任务",
      "cmds": [
        "启动管理",
        "开机自启",
        "自启动管理",
        "startup",
        "autoruns"
      ]
    },
    {
      "code": "startup-services",
      "explain": "专项排查并禁用第三方软件驻留的开机后台服务",
      "cmds": [
        "后台服务管理",
        "禁用第三方服务",
        "开机服务精简"
      ]
    },
    {
      "code": "startup-tasks",
      "explain": "专项排查并禁用软件偷偷注册的定时与开机计划任务",
      "cmds": [
        "计划任务管理",
        "开机计划任务",
        "流氓自启清理"
      ]
    }
  ],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "minAppVersion": "1.1.8.5",
  "defaultLocale": "zh-CN",
  "i18n": {
    "en-US": {
      "name": "Startup Manager",
      "description": "Inspect and toggle startup apps, background services, and scheduled tasks, preserving restorable configuration snapshots on macOS.",
      "keywords": [
        "startup",
        "autoruns",
        "services",
        "scheduled tasks",
        "boot"
      ],
      "features": {
        "startup-all": {
          "explain": "Manage all startup applications, third-party services, and boot tasks",
          "cmds": [
            "startup",
            "autoruns",
            "startup manager",
            "boot items"
          ]
        },
        "startup-services": {
          "explain": "Inspect and disable third-party background startup services",
          "cmds": [
            "background services",
            "startup services",
            "disable services"
          ]
        },
        "startup-tasks": {
          "explain": "Inspect and disable scheduled startup tasks",
          "cmds": [
            "scheduled tasks",
            "startup tasks",
            "boot tasks"
          ]
        }
      }
    }
  }
}
