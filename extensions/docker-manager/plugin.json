{
  "id": "docker-manager",
  "name": "容器管控",
  "version": "1.0.3",
  "description": "查看本机 Docker 容器、端口和资源采样，支持启停、日志与确认后清理停止容器；需已安装并启动 Docker 环境",
  "author": "ZTools Community",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "nativeComponents": [],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "permissions": [
    "fs",
    "shell",
    "network"
  ],
  "features": [
    {
      "code": "docker-all",
      "explain": "查看本地所有 Docker 容器状态、端口映射与实时日志",
      "cmds": [
        "docker",
        "容器管控",
        "docker管理",
        "容器",
        "ps"
      ]
    },
    {
      "code": "docker-running",
      "explain": "筛选运行中的容器并读取 CPU、内存采样",
      "cmds": [
        "运行中容器",
        "docker运行中",
        "在线容器"
      ]
    },
    {
      "code": "docker-clean-stopped",
      "explain": "列出已停止容器，确认清单后清理，保留挂载的数据卷",
      "cmds": [
        "清理容器",
        "删除停止容器",
        "docker清理"
      ]
    }
  ]
}
