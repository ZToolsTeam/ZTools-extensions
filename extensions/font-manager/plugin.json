{
  "id": "font-manager",
  "name": "字体管理",
  "version": "1.0.1",
  "description": "极速检索与实时预览本机安装字体，输入任意文案比对字形，内置免费可商用白名单识别库，远离字体侵权风险",
  "author": "ZTools Official",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "permissions": [
    "fs",
    "shell",
    "clipboard"
  ],
  "nativeComponents": [],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "features": [
    {
      "code": "font-manager-all",
      "explain": "检索并预览本机全部已安装字体",
      "cmds": [
        "字体管理",
        "字体预览",
        "系统字体",
        "查看字体",
        "fonts",
        "本机字体"
      ]
    },
    {
      "code": "font-manager-free-commercial",
      "explain": "仅筛选查看经白名单认证的免费可商用中英文字体",
      "cmds": [
        "免费商用字体",
        "可商用字体",
        "商用安全字体",
        "免费字体"
      ]
    },
    {
      "code": "font-manager-commercial-risk",
      "explain": "筛选查看具有商业版权限制、未经授权商用存在侵权风险的字体",
      "cmds": [
        "侵权字体排查",
        "版权字体",
        "商业字体"
      ]
    }
  ]
}
