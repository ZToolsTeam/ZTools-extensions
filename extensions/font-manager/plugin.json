{
  "id": "font-manager",
  "name": "字体管理",
  "version": "1.0.3",
  "description": "检索本机已安装字体，输入文字查看真实字形，查看字体文件附带的许可与版权说明。",
  "author": "ZTools Community",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "permissions": [
    "fs",
    "shell",
    "clipboard"
  ],
  "nativeComponents": [],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "features": [
    {
      "code": "font-manager-all",
      "explain": "检索并预览本机全部已安装字体",
      "cmds": [
        "字体管理",
        "字体预览",
        "系统字体",
        "查看字体",
        "fonts",
        "本机字体"
      ]
    },
    {
      "code": "font-manager-free-commercial",
      "explain": "查看字体文件附带的许可说明",
      "cmds": [
        "字体许可",
        "字体授权说明"
      ]
    },
    {
      "code": "font-manager-commercial-risk",
      "explain": "查看没有附带许可说明的字体",
      "cmds": [
        "未附许可字体",
        "字体版权信息"
      ]
    }
  ],
  "minAppVersion": "1.1.8.5"
}
