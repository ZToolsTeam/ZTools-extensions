{
  "id": "curl-http",
  "name": "轻量接口调试",
  "version": "1.0.9",
  "description": "解析 cURL 命令（bash / cmd 写法）或网址，由客户端发起 HTTP 请求查看响应，并生成 Fetch、Axios、Python、Go 请求代码",
  "author": "ZTools Team",
  "category": [
    "开发工具"
  ],
  "categoryId": "developer",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "nativeComponents": [],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "permissions": [
    "clipboard",
    "network"
  ],
  "features": [
    {
      "code": "curl-http",
      "explain": "解析 cURL 命令、执行轻量 HTTP 请求或生成多语言请求代码",
      "cmds": [
        "curl",
        "http",
        "api",
        "fetch",
        "postman",
        "接口调试",
        "cURL转换"
      ]
    }
  ],
  "defaultLocale": "zh-CN",
  "i18n": {
    "en-US": {
      "name": "Lightweight HTTP Client",
      "description": "Parse cURL commands (bash/cmd) or URLs, send HTTP requests to inspect responses, and generate Fetch, Axios, Python, and Go code snippets.",
      "keywords": [
        "curl",
        "http",
        "api",
        "rest",
        "fetch",
        "axios",
        "request",
        "debug"
      ],
      "features": {
        "curl-http": {
          "explain": "Parse cURL commands, send HTTP requests, or generate multi-language client code",
          "cmds": [
            "curl",
            "http",
            "api",
            "fetch",
            "rest client",
            "curl convert"
          ]
        }
      }
    }
  }
}
