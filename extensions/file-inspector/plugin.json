{
  "id": "file-inspector",
  "name": "文件透视与转码",
  "version": "1.0.10",
  "description": "按文件头识别真实格式并修正错误的扩展名；检查文本文件的编码与换行符，可另存为 UTF-8-BOM，解决 Excel 打开 CSV 乱码",
  "author": "ZTools Team",
  "category": [
    "文件管理"
  ],
  "categoryId": "files",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "permissions": [
    "fs",
    "dialog",
    "clipboard"
  ],
  "nativeComponents": [],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "features": [
    {
      "code": "file-inspector-workbench",
      "explain": "打开文件透视工作台，拖入或选择文件查看真实格式与编码",
      "cmds": [
        "文件透视",
        "文件转码",
        "文件编码检测",
        "检查文件",
        "file inspector"
      ]
    },
    {
      "code": "file-fix-csv-bom",
      "explain": "打开文件透视工作台，选择 CSV 或文本文件后另存为带 BOM 的 UTF-8，解决 Excel 打开乱码",
      "cmds": [
        "csv乱码修复",
        "csv转utf8bom",
        "解决excel乱码",
        "修复csv"
      ]
    },
    {
      "code": "file-fix-extension",
      "explain": "打开文件透视工作台，选择文件后按文件头识别真实格式，把错误的扩展名（如实为 webp 的 .jpg）改回真实扩展名",
      "cmds": [
        "修复假后缀",
        "识别真实文件后缀",
        "后缀修复",
        "fix extension"
      ]
    }
  ],
  "defaultLocale": "zh-CN",
  "i18n": {
    "en-US": {
      "name": "File Inspector & Transcoder",
      "description": "Detect true file formats via magic bytes to fix mismatched extensions, inspect text encoding and line endings, and save as UTF-8 with BOM to fix garbled CSVs in Excel.",
      "keywords": [
        "file inspector",
        "encoding",
        "utf8",
        "bom",
        "csv",
        "extension",
        "magic bytes"
      ],
      "features": {
        "file-inspector-workbench": {
          "explain": "Open File Inspector to check real file formats and text encodings",
          "cmds": [
            "file inspector",
            "check file",
            "file encoding",
            "inspect file"
          ]
        },
        "file-fix-csv-bom": {
          "explain": "Save CSV or text files as UTF-8 with BOM to fix garbled characters in Excel",
          "cmds": [
            "fix csv",
            "csv bom",
            "utf8 bom",
            "excel csv fix"
          ]
        },
        "file-fix-extension": {
          "explain": "Detect real file type from headers and fix mismatched file extensions",
          "cmds": [
            "fix extension",
            "real file type",
            "magic bytes",
            "detect format"
          ]
        }
      },
      "screenshots": [
        {
          "file": "screenshots/en-US/01.png"
        }
      ]
    }
  },
  "screenshots": [
    {
      "path": "screenshots/01-overview.png"
    },
    {
      "path": "screenshots/02-action-panel.png"
    }
  ]
}
