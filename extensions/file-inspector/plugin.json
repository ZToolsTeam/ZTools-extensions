{
  "id": "file-inspector",
  "name": "文件透视与转码",
  "version": "1.0.5",
  "description": "按文件头识别真实格式并修正错误的扩展名；检查文本文件的编码与换行符，可另存为 UTF-8-BOM，解决 Excel 打开 CSV 乱码",
  "author": "ZTools Team",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "permissions": [
    "fs",
    "dialog",
    "clipboard"
  ],
  "nativeComponents": [],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "features": [
    {
      "code": "file-inspector-workbench",
      "explain": "打开文件透视工作台，拖入或选择文件查看真实格式与编码",
      "cmds": [
        "文件透视",
        "文件转码",
        "文件编码检测",
        "检查文件",
        "file inspector"
      ]
    },
    {
      "code": "file-fix-csv-bom",
      "explain": "打开文件透视工作台，选择 CSV 或文本文件后另存为带 BOM 的 UTF-8，解决 Excel 打开乱码",
      "cmds": [
        "csv乱码修复",
        "csv转utf8bom",
        "解决excel乱码",
        "修复csv"
      ]
    },
    {
      "code": "file-fix-extension",
      "explain": "打开文件透视工作台，选择文件后按文件头识别真实格式，把错误的扩展名（如实为 webp 的 .jpg）改回真实扩展名",
      "cmds": [
        "修复假后缀",
        "识别真实文件后缀",
        "后缀修复",
        "fix extension"
      ]
    }
  ]
}
