{
  "id": "jwt-url-codec",
  "name": "JWT与URL解析",
  "version": "1.0.8",
  "description": "离线解析 JWT Token（Header/Payload/生命周期倒计时/HMAC-SHA256 验签与签发）与深度 URL Query 参数拆解重组工具",
  "author": "ZTools Team",
  "category": [
    "开发工具"
  ],
  "categoryId": "developer",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "nativeComponents": [],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "permissions": [
    "clipboard",
    "crypto"
  ],
  "features": [
    {
      "code": "jwt-url-codec",
      "explain": "解析 JWT Token 载荷、校验 HMAC 签名或深度拆解 URL 参数",
      "cmds": [
        "jwt",
        "token",
        "url",
        "urlencode",
        "urldecode",
        "querystring",
        "JWT解析",
        "URL解析"
      ]
    }
  ],
  "defaultLocale": "zh-CN",
  "i18n": {
    "en-US": {
      "name": "JWT & URL Inspector",
      "description": "Decode JWT tokens offline (Header, Payload, expiration countdown, HMAC-SHA256 signing & verification) and parse or rebuild deep URL query parameters.",
      "keywords": [
        "jwt",
        "token",
        "url",
        "querystring",
        "hmac",
        "decode",
        "encode"
      ],
      "features": {
        "jwt-url-codec": {
          "explain": "Decode JWT payloads, verify HMAC signatures, or inspect URL query parameters",
          "cmds": [
            "jwt",
            "token",
            "url",
            "urlencode",
            "urldecode",
            "querystring"
          ]
        }
      }
    }
  }
}
