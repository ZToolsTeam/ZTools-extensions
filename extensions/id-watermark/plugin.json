{
  "id": "id-watermark",
  "name": "防盗水印",
  "version": "1.0.11",
  "description": "本地为 JPG、PNG、WebP 图片添加斜向文字水印，保留原图，另存 PNG 新副本或复制图片",
  "author": "ZTools Team",
  "category": [
    "图像媒体",
    "安全隐私"
  ],
  "categoryId": [
    "media",
    "security"
  ],
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "permissions": [
    "clipboard",
    "dialog",
    "fs"
  ],
  "nativeComponents": [],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "features": [
    {
      "code": "id-watermark-workbench",
      "explain": "选择原图和用途，另存加水印的新副本",
      "cmds": [
        "防盗水印",
        "身份证水印",
        "证件水印",
        "加水印",
        "营业执照水印",
        "watermark"
      ]
    },
    {
      "code": "id-watermark-clipboard-fast",
      "explain": "读取剪贴板图片，确认水印文字后按 Enter 复制结果",
      "cmds": [
        "快速加水印",
        "剪贴板照片加水印"
      ]
    }
  ],
  "minAppVersion": "1.1.8.4",
  "defaultLocale": "zh-CN",
  "i18n": {
    "en-US": {
      "name": "ID Watermark",
      "description": "Add diagonal text watermarks locally to JPG, PNG, and WebP images without modifying originals; save as PNG copies or copy directly to clipboard.",
      "keywords": [
        "watermark",
        "id card",
        "privacy",
        "image",
        "protect",
        "stamp"
      ],
      "features": {
        "id-watermark-workbench": {
          "explain": "Select an image and watermark purpose to save a watermarked copy",
          "cmds": [
            "watermark",
            "id watermark",
            "add watermark",
            "protect image"
          ]
        },
        "id-watermark-clipboard-fast": {
          "explain": "Watermark an image from the clipboard and copy the result on Enter",
          "cmds": [
            "quick watermark",
            "clipboard watermark"
          ]
        }
      }
    }
  }
}
