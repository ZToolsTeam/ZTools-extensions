{
  "id": "process-monitor",
  "name": "进程监控",
  "description": "查看本机进程的 CPU 与内存占用、查询本地端口被哪个进程占用，可定位程序文件，确认后结束进程",
  "version": "2.0.12",
  "author": "ZTools Team",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "category": [
    "系统工具"
  ],
  "categoryId": "system",
  "keywords": [
    "进程监控",
    "任务管理器",
    "结束进程",
    "杀进程",
    "端口占用",
    "查端口",
    "port",
    "process",
    "kill",
    "cpu",
    "内存占用"
  ],
  "features": [
    {
      "code": "kill-high-cpu",
      "explain": "排查并结束高 CPU / 内存占用进程",
      "cmds": [
        "进程监控",
        "结束进程",
        "杀进程",
        "任务管理器",
        "卡死",
        "高cpu",
        "内存占用"
      ]
    },
    {
      "code": "port-lookup",
      "explain": "本地网络端口占用查询与进程释放",
      "cmds": [
        "端口占用",
        "查端口",
        "端口查询",
        "释放端口",
        "port",
        "netstat",
        "8080",
        "3000"
      ]
    }
  ],
  "permissions": [
    "system",
    "shell",
    "process",
    "clipboard"
  ],
  "requireAdmin": false,
  "nativeComponents": [],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "defaultLocale": "zh-CN",
  "i18n": {
    "en-US": {
      "name": "Process & Port Monitor",
      "description": "Inspect CPU and memory usage by process, look up which process owns a local port, reveal executables in folder, and terminate processes after confirmation.",
      "keywords": [
        "process",
        "port",
        "kill",
        "cpu",
        "memory",
        "netstat",
        "task manager"
      ],
      "features": {
        "kill-high-cpu": {
          "explain": "Inspect and terminate high CPU or memory processes",
          "cmds": [
            "process monitor",
            "kill process",
            "task manager",
            "high cpu"
          ]
        },
        "port-lookup": {
          "explain": "Find which process is using a local port and release it",
          "cmds": [
            "port",
            "port lookup",
            "netstat",
            "free port",
            "8080",
            "3000"
          ]
        }
      }
    }
  }
}
