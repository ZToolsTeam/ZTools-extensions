{
  "id": "screenshot",
  "name": "截图历史",
  "description": "截取全部屏幕，浏览本机截图历史，支持复制、回贴、列表置顶与批量清理",
  "version": "2.0.15",
  "author": "ZTools Team",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "category": [
    "办公效率",
    "图像媒体"
  ],
  "categoryId": [
    "productivity",
    "media"
  ],
  "permissions": [
    "screen",
    "clipboard",
    "fs"
  ],
  "requireAdmin": false,
  "nativeComponents": [],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "defaultLocale": "zh-CN",
  "i18n": {
    "en-US": {
      "name": "Screenshot History",
      "description": "Capture full-screen screenshots and browse local screenshot history with copy, paste, pinning, and batch cleanup.",
