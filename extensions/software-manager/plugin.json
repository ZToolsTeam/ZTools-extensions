{
  "id": "software-manager",
  "name": "软件卸载",
  "description": "全面列出电脑已安装软件、占用体积与使用频率，支持强力卸载并彻底扫除注册表与文件夹残留",
  "version": "2.0.6",
  "author": "ZTools Team",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "category": [
    "系统工具"
  ],
  "keywords": [
    "软件卸载",
    "应用卸载",
    "强力卸载",
    "残留清理",
    "应用管理",
    "已安装软件",
    "uninstall",
    "applications"
  ],
  "features": [
    {
      "code": "uninstall-all",
      "explain": "强力卸载已安装软件并清理注册表残留",
      "cmds": [
        "软件卸载",
        "应用卸载",
        "卸载软件",
        "强力卸载",
        "应用管理",
        "uninstall"
      ]
    },
    {
      "code": "uninstall-large",
      "explain": "按空间占用排查并清理大体积软件",
      "cmds": [
        "大体积软件",
        "大软件清理",
        "软件占用空间"
      ]
    }
  ],
  "permissions": [
    "system",
    "fs",
    "shell"
  ],
  "requireAdmin": false,
  "nativeComponents": [],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    }
  ]
}
