{
  "id": "env-manager",
  "name": "环境变量",
  "version": "1.0.3",
  "description": "管理 Windows 注册表环境与 macOS 终端变量，查看只读进程快照，预览 PATH 清理，修改前保留可恢复备份",
  "author": "ZTools Community",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "nativeComponents": [],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "permissions": [
    "fs",
    "shell",
    "system",
    "clipboard"
  ],
  "features": [
    {
      "code": "env-all",
      "explain": "查看当前进程、管理 Windows 用户与系统变量或 macOS 终端变量",
      "cmds": [
        "环境变量",
        "path",
        "环境变量管理",
        "env",
        "查看path"
      ]
    },
    {
      "code": "env-path-clean",
      "explain": "预览并清理持久配置中确认不存在的 PATH 目录",
      "cmds": [
        "清理path",
        "path失效路径",
        "清理环境变量",
        "修复path"
      ]
    },
    {
      "code": "env-backup",
      "explain": "查看和恢复修改前的配置备份，复制当前变量快照",
      "cmds": [
        "备份环境变量",
        "导出环境变量"
      ]
    }
  ]
}
