{
  "id": "env-manager",
  "name": "环境变量",
  "version": "1.0.9",
  "description": "管理 Windows 注册表环境与 macOS 终端变量，查看只读进程快照，预览 PATH 清理，修改前保留可恢复备份",
  "author": "ZTools Team",
  "category": [
    "开发工具"
  ],
  "categoryId": "developer",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "nativeComponents": [],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "permissions": [
    "fs",
    "system",
    "clipboard"
  ],
  "features": [
    {
      "code": "env-all",
      "explain": "查看当前进程变量；在 Windows 上管理用户与系统变量，在 macOS 上管理新终端加载的变量",
      "cmds": [
        "环境变量",
        "path",
        "环境变量管理",
        "env",
        "查看path"
      ]
    },
    {
      "code": "env-path-clean",
      "explain": "预览并清理持久配置中确认不存在的 PATH 目录",
      "cmds": [
        "清理path",
        "path失效路径",
        "清理环境变量",
        "修复path"
      ]
    },
    {
      "code": "env-backup",
      "explain": "查看和恢复修改前的配置备份，复制当前变量快照",
      "cmds": [
        "备份环境变量",
        "导出环境变量"
      ]
    }
  ],
  "minAppVersion": "1.1.8.5",
  "defaultLocale": "zh-CN",
  "i18n": {
    "en-US": {
      "name": "Environment Variables",
      "description": "Manage Windows registry and macOS shell environment variables, inspect process snapshots, preview invalid PATH cleanup, and keep restorable backups.",
      "keywords": [
        "env",
        "environment",
        "path",
        "variables",
        "shell",
        "registry"
      ],
      "features": {
        "env-all": {
          "explain": "Inspect process variables and manage Windows or macOS persistent environment variables",
          "cmds": [
            "env",
            "path",
            "environment variables",
            "env manager"
          ]
        },
        "env-path-clean": {
          "explain": "Preview and clean nonexistent directories from persistent PATH entries",
          "cmds": [
            "clean path",
            "fix path",
            "invalid path",
            "cleanup env"
          ]
        },
        "env-backup": {
          "explain": "View or restore pre-edit backups and copy current variable snapshots",
          "cmds": [
            "backup env",
            "export env",
            "restore env"
          ]
        }
      },
      "screenshots": [
        {
          "file": "screenshots/en-US/01.png"
        }
      ]
    }
  },
  "screenshots": [
    {
      "path": "screenshots/01.png"
    }
  ]
}
