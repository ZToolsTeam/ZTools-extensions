{
  "id": "system-tools",
  "name": "系统工具",
  "description": "把锁屏、睡眠、休眠、重启、关机、注销、系统音量与静音、显示隐藏文件、清空回收站、防止熄屏等系统操作集中在一个列表里，回车执行，重启、关机、注销和清空回收站执行前会确认",
  "version": "2.0.7",
  "author": "ZTools Team",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "category": [
    "系统工具"
  ],
  "keywords": [
    "系统工具",
    "锁屏",
    "睡眠",
    "休眠",
    "重启",
    "关机",
    "注销",
    "静音",
    "音量",
    "隐藏文件",
    "回收站",
    "防止熄屏"
  ],
  "features": [
    {
      "code": "sys-power",
      "explain": "锁屏、睡眠、休眠、重启、关机与注销",
      "cmds": [
        "系统工具",
        "锁屏",
        "睡眠",
        "休眠",
        "重启",
        "关机",
        "注销"
      ]
    },
    {
      "code": "sys-misc",
      "explain": "系统音量与静音、显示隐藏文件、清空回收站、防止熄屏",
      "cmds": [
        "系统音量",
        "静音",
        "显示隐藏文件",
        "清空回收站",
        "防止熄屏"
      ]
    }
  ],
  "permissions": [
    "system"
  ],
  "requireAdmin": false,
  "nativeComponents": [],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    }
  ]
}
