{
  "id": "system-tools",
  "name": "系统工具",
  "description": "一站式直达注册表、环境变量、服务管理、设备管理器、磁盘管理、组策略与控制面板等系统入口",
  "version": "2.0.5",
  "author": "ZTools Team",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "category": [
    "系统工具"
  ],
  "keywords": [
    "系统工具",
    "注册表",
    "环境变量",
    "服务管理",
    "设备管理器",
    "组策略",
    "控制面板",
    "cmd",
    "regedit"
  ],
  "features": [
    {
      "code": "sys-regedit",
      "explain": "注册表、环境变量、服务与组策略直达",
      "cmds": [
        "注册表",
        "regedit",
        "环境变量",
        "服务管理",
        "services",
        "组策略",
        "设备管理器",
        "磁盘管理"
      ]
    },
    {
      "code": "sys-run",
      "explain": "Windows 运行命令与控制面板快捷入口",
      "cmds": [
        "运行命令",
        "控制面板",
        "control",
        "上帝模式",
        "godmode",
        "刷新dns"
      ]
    }
  ],
  "permissions": [
    "system",
    "shell"
  ],
  "requireAdmin": false,
  "nativeComponents": [],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    }
  ]
}
