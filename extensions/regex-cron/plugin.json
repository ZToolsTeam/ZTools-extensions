{
  "id": "regex-cron",
  "name": "正则与Cron",
  "version": "1.0.4",
  "description": "中国本土常用正则速查与实时测试高亮，支持Cron表达式中文语义解析与未来5次执行时间推算",
  "author": "ZTools Team",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "nativeComponents": [],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "permissions": [
    "clipboard"
  ],
  "features": [
    {
      "code": "regex-dict",
      "explain": "查阅并一键复制中国本土业务高频正则表达式（身份证/手机/税号/车牌等）",
      "cmds": [
        "常用正则",
        "正则表达式",
        "regex",
        "手机号正则",
        "身份证正则",
        "车牌正则"
      ]
    },
    {
      "code": "regex-tester",
      "explain": "实时正则匹配测试器，支持输入模式与待测文本并实时高亮捕获组",
      "cmds": [
        "正则测试",
        "测试正则",
        "正则调试",
        "regex test",
        "正则匹配"
      ]
    },
    {
      "code": "cron-explainer",
      "explain": "Cron表达式中文翻译与未来5次执行时间推算",
      "cmds": [
        "cron",
        "crontab",
        "定时任务时间",
        "cron翻译",
        "cron推算",
        "cron计算器"
      ]
    }
  ]
}
