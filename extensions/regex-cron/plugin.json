{
  "id": "regex-cron",
  "name": "正则与Cron",
  "version": "1.0.5",
  "description": "中国本土常用正则速查与实时测试高亮，支持Cron表达式中文语义解析与未来5次执行时间推算",
  "author": "ZTools Team",
  "category": [
    "开发工具"
  ],
  "categoryId": "developer",
  "entry": "dist/index.js",
  "icon": "icon.svg",
  "nativeComponents": [],
  "targets": [
    {
      "id": "windows-electron-any",
      "platform": "windows",
      "runtime": "electron",
      "arch": "any"
    },
    {
      "id": "macos-electron-any",
      "platform": "macos",
      "runtime": "electron",
      "arch": "any"
    }
  ],
  "permissions": [
    "clipboard"
  ],
  "features": [
    {
      "code": "regex-dict",
      "explain": "查阅并一键复制中国本土业务高频正则表达式（身份证/手机/税号/车牌等）",
      "cmds": [
        "常用正则",
        "正则表达式",
        "regex",
        "手机号正则",
        "身份证正则",
        "车牌正则"
      ]
    },
    {
      "code": "regex-tester",
      "explain": "实时正则匹配测试器，支持输入模式与待测文本并实时高亮捕获组",
      "cmds": [
        "正则测试",
        "测试正则",
        "正则调试",
        "regex test",
        "正则匹配"
      ]
    },
    {
      "code": "cron-explainer",
      "explain": "Cron表达式中文翻译与未来5次执行时间推算",
      "cmds": [
        "cron",
        "crontab",
        "定时任务时间",
        "cron翻译",
        "cron推算",
        "cron计算器"
      ]
    }
  ],
  "defaultLocale": "zh-CN",
  "i18n": {
    "en-US": {
      "name": "Regex & Cron Toolkit",
      "description": "Browse common regex presets, test patterns live with capture group highlighting, and explain Cron expressions with the next 5 scheduled run times.",
      "keywords": [
        "regex",
        "regexp",
        "cron",
        "crontab",
        "tester",
        "schedule"
      ],
      "features": {
        "regex-dict": {
          "explain": "Browse and copy common business regex presets (ID, phone, tax ID, license plate, etc.)",
          "cmds": [
            "regex",
            "regex presets",
            "common regex",
            "regexp"
          ]
        },
        "regex-tester": {
          "explain": "Test regular expressions in real time with capture group highlighting",
          "cmds": [
            "regex test",
            "regex tester",
            "test regex",
            "regexp debug"
          ]
        },
        "cron-explainer": {
          "explain": "Explain Cron expressions and preview the next 5 execution times",
          "cmds": [
            "cron",
            "crontab",
            "cron parser",
            "cron schedule"
          ]
        }
      },
      "screenshots": [
        {
          "file": "screenshots/en-US/01.png"
        }
      ]
    }
  },
  "screenshots": [
    {
      "path": "screenshots/01-overview.png"
    },
    {
      "path": "screenshots/02-action-panel.png"
    },
    {
      "path": "screenshots/03-interactive.png"
    }
  ]
}
